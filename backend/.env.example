# AI Provider API Keys
# The application supports multiple AI providers. Uncomment and set the one(s) you wish to use.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_API_BASE=https://api.anthropic.com

# GOOGLE_API_KEY=your_gemini_api_key_here
# GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta

# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_API_BASE=https://api.deepseek.com

# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_API_BASE=https://api.mistral.ai/v1

# GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_BASE=https://api.groq.com/openai/v1

# META_API_KEY=your_meta_api_key_here
# META_API_BASE=

# ALIBABA_API_KEY=your_alibaba_api_key_here
# ALIBABA_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# AZURE_API_KEY=your_azure_api_key_here
# AZURE_API_BASE=

# LOCAL_API_KEY=dummy
# LOCAL_API_BASE=http://127.0.0.1:8080/v1

# OLLAMA_API_KEY=dummy
# OLLAMA_API_BASE=http://127.0.0.1:11434/v1
# Application Settings
DEBUG=True

# --- Initial Admin Settings ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=User
INITIAL_ADMIN_EMAIL=admin@example.com

# --- Initial Global AI Config ---
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini
DEFAULT_OPENAI_API_KEY=your_openai_api_key_here
# DEFAULT_ANTHROPIC_API_KEY=your_anthropic_key_here

# --- File Storage Settings ---
DOCUMENTS_STORAGE_PATH=.

# --- Job Discovery API Keys ---
# Used by the Discover page (backend/services/job_search_service.py).
# All optional: providers without a key are skipped, and TheMuse + RemoteOK
# need no key at all, so Discover still works with none of these set.
#
# Adzuna — free tier: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
#
# JSearch — via OpenWeb Ninja (NOT RapidAPI): https://www.openwebninja.com/
# Sent as the X-API-Key header against api.openwebninja.com/jsearch/search-v2
JSEARCH_KEY=your_jsearch_key_here
