# ── JobApplicationAutomator — Root Environment Variables ──────────────────────
#
# This file controls Docker Compose-level settings (ports, build args, etc.)
# It is separate from backend/.env which controls the app's runtime config.
#
# Setup:
#   cp .env.example .env
#   Edit .env for your environment, then:
#   docker compose up -d --build

# ── Port Assignments ──────────────────────────────────────────────────────────
# The frontend (Nginx) is the main entry point for the application.
FRONTEND_PORT=80

# OnlyOffice Document Server — must be reachable from the user's browser.
ONLYOFFICE_PORT=8443

# ── OnlyOffice URL ────────────────────────────────────────────────────────────
# The URL the browser uses to connect to OnlyOffice for the resume editor.
# Change to your server's IP or domain if deploying remotely.
# Example: VITE_ONLYOFFICE_URL=http://192.168.1.100:8443
VITE_ONLYOFFICE_URL=http://localhost:8443

# ── API URL ───────────────────────────────────────────────────────────────────
# Leave empty — Nginx proxies /api/* to the backend automatically.
# Only set this if you are NOT using the Nginx proxy (e.g., direct dev mode).
# Example: VITE_API_URL=http://my-server.example.com:8000
VITE_API_URL=

# ── Optional: Mount a local documents folder ──────────────────────────────────
# Uncomment and set to expose a local folder inside the backend container.
# Useful for accessing locally-stored base resumes.
# The folder will be available at /mnt/documents inside the container.
# DOCUMENTS_HOST_PATH=/path/to/your/documents

# ── Optional: PostgreSQL (instead of default SQLite) ─────────────────────────
# Uncomment all lines below and launch with: docker compose --profile postgres up
#
# POSTGRES_USER=jobapp
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=jobapp_db
# DATABASE_URL=postgresql://jobapp:changeme@db:5432/jobapp_db
